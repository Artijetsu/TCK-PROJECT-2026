extends CharacterBody2D

# Скорость передвижения персонажа в пикселях в секунду.
# Ты можешь поменять это значение, чтобы сделать персонажа быстрее или медленнее.
@export var speed: float = 150.0

# Эта функция вызывается каждый кадр (очень-очень часто).
# В ней мы будем проверять нажатия клавиш и двигать персонажа.
func _physics_process(delta: float):
    # Сначала мы получаем "вектор направления". Это как стрелочка, которая показывает, куда игрок хочет двигаться.
    # Input.get_vector() сама проверяет нажатия клавиш "влево", "вправо", "вверх", "вниз"
    # и возвращает направление. Например, если нажать "вправо", вернётся (1, 0). Если "вверх" - (0, -1).
    var direction = Input.get_vector("ui_left", "ui_right", "ui_up", "ui_down")

    # Теперь мы задаём скорость персонажа.
    # Мы умножаем направление на нашу скорость.
    # Если направление (0,0) (ничего не нажато), то и скорость будет (0,0).
    velocity = direction * speed

    # А вот и самая главная функция!
    # move_and_slide() двигает нашего персонажа, используя его скорость (velocity).
    # Самое важное: она автоматически обрабатывает столкновения со стенами и другими объектами.
    # Если персонаж врезается в стену, эта функция не даст ему пройти сквозь неё.
    move_and_slide()
